@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct: <http://purl.org/dc/terms/> .

# Building instances uplift to crm:E22_Man-Made_Object (via the inherited HeritageObject type
# mapping). The parent heritage-object shapes check objectType/material/currentLocation IRIs.
# These shapes add constraints specific to the building profile.
<#BuildingShape>
    a sh:NodeShape ;
    sh:targetClass crm:E22_Man-Made_Object ;
    sh:property [
        sh:path crm:P46i_forms_part_of ;
        sh:nodeKind sh:IRI ;
        sh:message "parentSite must uplift to an IRI" ;
    ] ;
    sh:property [
        sh:path crm:P50_has_current_keeper ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "responsibleOrganisation must be a string or IRI" ;
    ] ;
    sh:property [
        sh:path dct:created ;
        sh:nodeKind sh:Literal ;
        sh:message "constructionPeriod must be a literal string" ;
    ] .
