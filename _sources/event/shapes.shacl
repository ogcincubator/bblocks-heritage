@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix hdto: <http://isl.ics.forth.gr/ontology/echoes/> .

# As with `place` and `actor`, an Event's rdf:type comes from PROV-O (prov:Activity) rather than
# crm:E5_Event, so this shape targets by predicate rather than by class.
<#EventTypeIsIRI>
    a sh:NodeShape ;
    sh:targetSubjectsOf crm:P2_has_type ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:nodeKind sh:IRI ;
        sh:message "eventType must uplift to an IRI (was it a relative or malformed URI?)" ;
    ] .

# HDTO HC11/HC13 co-typing validation. hdtoType (required by schema.yaml's if/then exactly when
# eventType is itself the matching HDTO class URI) maps via context.jsonld directly to rdf:type —
# asserted on a plain JSON-LD parse, no post-processing step needed.
<#HC11DigitalTwinMaintenanceShape>
    a sh:NodeShape ;
    sh:targetClass hdto:HC11_Digital_Twin_Maintenance ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "hdto:HC11_Digital_Twin_Maintenance instances should record who carried out the maintenance (wasAssociatedWith)" ;
    ] .

<#HC13ProjectShape>
    a sh:NodeShape ;
    sh:targetClass hdto:HC13_Project ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:minCount 1 ;
        sh:message "hdto:HC13_Project instances must carry eventType (crm:P2_has_type)" ;
    ] .
