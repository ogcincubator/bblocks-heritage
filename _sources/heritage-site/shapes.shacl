@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct: <http://purl.org/dc/terms/> .

# Heritage-site instances are JSON-FG Features; `type` is fixed to "Feature" so there is no
# crm:E27_Site class triple after uplift (same gotcha as ogc.heritage.place).
# Target on crm:P2_has_type, which siteType (required) always produces.
<#HeritageSiteShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf crm:P2_has_type ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "siteType must be present and must resolve to an IRI" ;
    ] ;
    sh:property [
        sh:path crm:P50_has_current_keeper ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "responsibleOrganisation must be a string or IRI" ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "rights must be a string or IRI" ;
    ] .
