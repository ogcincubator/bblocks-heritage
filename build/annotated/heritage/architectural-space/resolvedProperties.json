{"defs":{},"properties":[{"path":["id"],"id":"@id","description":"The persistent or local URI identifying this object.","schema_type":"string","format":"uri","effectiveId":"@id"},{"path":["type"],"id":"@type","const":"HeritageObject","effectiveId":"@type"},{"path":["identifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"A local catalogue or inventory number (CIDOC-CRM P1_is_identified_by).","required":true,"schema_type":"string","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["title"],"id":"http://www.cidoc-crm.org/cidoc-crm/P102_has_title","description":"A human-readable title or name for the object (CIDOC-CRM P102_has_title).","required":true,"schema_type":"string","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P102_has_title"},{"path":["description"],"id":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note","description":"Free-text description or curatorial note (CIDOC-CRM P3_has_note).","schema_type":"string","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note"},{"path":["objectType"],"id":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type","jsonld_type":"@id","description":"The type of object, typically a Getty AAT concept URI (CIDOC-CRM P2_has_type).","schema_type":"string","format":"uri","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type"},{"path":["material"],"id":"http://www.cidoc-crm.org/cidoc-crm/P45_consists_of","jsonld_type":"@id","description":"Materials the object consists of, typically Getty AAT concept URIs (CIDOC-CRM P45_consists_of).","schema_type":"array","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P45_consists_of"},{"path":["currentLocation"],"id":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location","jsonld_type":"@id","description":"URI of the place where the object is currently or was last located (CIDOC-CRM P53_has_former_or_current_location).","schema_type":"string","format":"uri","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location"},{"path":["persistentIdentifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","jsonld_type":"@id","description":"A persistent identifier (e.g. ARK, DOI, Handle) minted for this object.","schema_type":"string","format":"uri","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["parentBuilding"],"id":"http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of","jsonld_type":"@id","description":"URI of the building this space belongs to (crm:P46i_forms_part_of).","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of"},{"path":["partOf"],"id":"http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of","jsonld_type":"@id","description":"URI of a broader space this space is contained within, for multi-level hierarchies (e.g. a bay within a gallery wing). Also crm:P46i_forms_part_of.","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of"},{"path":["historicalNames"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","jsonld_type":"@json","description":"Historical names or codes for this space from legacy inventories (e.g. Guarini room numbers, archival room labels). Each entry has a name, an optional date period and an optional source reference.","schema_type":"array","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["historicalNames","name"],"required":true,"schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"]},{"path":["historicalNames","datePeriod"],"description":"ISO 8601 date or period string (e.g. \"1700/1750\").","schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"]},{"path":["historicalNames","source"],"description":"Reference to the inventory or document where this name appears.","schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"]},{"path":["floorLevel"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"Floor or storey identifier (e.g. \"ground floor\", \"piano nobile\", \"1\") (crm:P1_is_identified_by).","schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["bayCode"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"Bay or module code within the parent space, from a legacy inventory or survey (crm:P1_is_identified_by).","schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["accessibilityStatus"],"id":"http://www.cidoc-crm.org/cidoc-crm/P44_has_condition","description":"Current accessibility status (e.g. \"open to public\", \"restricted\", \"closed for restoration\"). Maps to crm:P44_has_condition.","schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P44_has_condition"},{"path":["monitoringRelevance"],"description":"True when environmental or condition monitoring equipment is deployed in this space (links to monitoring-point records).","schema_type":"boolean","sources":["bblocks://ogc.heritage.architectural-space"]},{"path":["ifcSpaceRef"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"IFC Global ID (GUID) of the corresponding IfcSpace element in an HBIM model, when available (crm:P1_is_identified_by).","schema_type":"string","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["footprint"],"id":"https://purl.org/geojson/vocab#geometry","jsonld_type":"@json","description":"Optional GeoJSON geometry representing the space's floor plan polygon or volumetric extent.","schema_type":"object","sources":["bblocks://ogc.heritage.architectural-space"],"effectiveId":"https://purl.org/geojson/vocab#geometry"},{"path":["footprint","type"],"required":true,"schema_type":"string","enum":["Point","Polygon","MultiPolygon"],"sources":["bblocks://ogc.heritage.architectural-space"]},{"path":["footprint","coordinates"],"required":true,"schema_type":"array","sources":["bblocks://ogc.heritage.architectural-space"]}]}