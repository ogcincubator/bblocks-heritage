@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix crmdig:  <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .

# type: "SurveyDataset" maps via context to crmdig:D1_Digital_Object,
# enabling sh:targetClass here. Shape only checks properties introduced by
# this profile; parent-block constraints are inherited via isProfileOf.
<#SurveyDatasetShape>
    a sh:NodeShape ;
    sh:targetClass crmdig:D1_Digital_Object ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:message "title (dct:title) is required." ;
    ] ;
    sh:property [
        sh:path crmdig:L11i_was_output_of ;
        sh:minCount 1 ;
        sh:message "acquisitionEvent (crmdig:L11i_was_output_of, i.e. the D7 acquisition event) is required." ;
    ] ;
    sh:property [
        sh:path geojson:geometry ;
        sh:minCount 1 ;
        sh:message "coverage geometry (geojson:geometry) is required." ;
    ] ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "isAbout (crm:P129_is_about) is required — URI of the surveyed heritage asset." ;
    ] .
