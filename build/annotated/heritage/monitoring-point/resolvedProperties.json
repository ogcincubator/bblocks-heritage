{"defs":{},"properties":[{"path":["type"],"id":"@type","description":"Fixed type token. Maps to crm:E22_Man-Made_Object in the JSON-LD context, enabling SHACL shapes to target monitoring points by class.","required":true,"const":"MonitoringPoint","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"@type"},{"path":["identifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"Local inventory code for this sensor or hotspot within the pilot system (crm:P1_is_identified_by). Distinct from the STA @iot.id.","required":true,"schema_type":"string","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["sensorType"],"id":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type","jsonld_type":"@id","description":"Category of sensor or monitoring equipment as a Getty AAT URI (crm:P2_has_type). Examples: temperature sensor, relative-humidity sensor, crack monitor.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type"},{"path":["locatedIn"],"id":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location","jsonld_type":"@id","description":"URI of the heritage resource (architectural-space, heritage-object, or place) where this monitoring point is installed (crm:P53_has_former_or_current_location).","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location"},{"path":["operationalStatus"],"id":"http://www.cidoc-crm.org/cidoc-crm/P44_has_condition","description":"Current operational state, e.g. \"active\", \"decommissioned\", \"under maintenance\" (crm:P44_has_condition).","schema_type":"string","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P44_has_condition"},{"path":["responsibleOrganisation"],"id":"http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper","description":"Name or URI of the body responsible for operating this monitoring point (crm:P50_has_current_keeper).","schema_type":"string","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper"},{"path":["position"],"id":"https://purl.org/geojson/vocab#geometry","jsonld_type":"@json","description":"GeoJSON Point giving the sensor's physical position. Use 3D coordinates [longitude, latitude, elevation_m] where known.","required":true,"schema_type":"object","sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"https://purl.org/geojson/vocab#geometry"},{"path":["position","type"],"id":"@type","required":true,"schema_type":"string","enum":["Point"],"sources":["bblocks://ogc.heritage.monitoring-point"],"effectiveId":"@type"},{"path":["position","coordinates"],"required":true,"schema_type":"array","sources":["bblocks://ogc.heritage.monitoring-point"]},{"path":["name"],"schema_type":"string","sources":["bblocks://ogc.sosa.properties.sensor"]},{"path":["id"],"id":"@id","sources":["bblocks://ogc.sosa.properties.sensor"],"effectiveId":"@id"}]}