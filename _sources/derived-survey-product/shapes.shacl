@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix crmdig:  <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .

# type: "DerivedSurveyProduct" maps via context to crmdig:D9_Data_Object. D9 is no longer unique
# to this block, though: digital-representation and its profiles (oral-history, three-d-model,
# archival-document) now all assert crmdig:D9_Data_Object too (their shared crmdigType, required
# HDTO-compliance work). Targeting by class here would false-positive-fail a plain photo/3D-model/
# document that lacks processingEvent. Target instead on crmdig:L11i_was_output_of
# (processingEvent), a predicate unique to this block, per the register's own convention for
# exactly this situation (see feedback_bblocks_authoring memory).
<#DerivedSurveyProductShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf crmdig:L11i_was_output_of ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:message "title (dct:title) is required." ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "parentDataset (prov:wasDerivedFrom) is required and must be an IRI referencing the source survey dataset." ;
    ] ;
    sh:property [
        sh:path crmdig:L11i_was_output_of ;
        sh:minCount 1 ;
        sh:message "processingEvent (crmdig:L11i_was_output_of, i.e. the D10 Software Execution) is required." ;
    ] ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "isAbout (crm:P129_is_about) is required — URI of the heritage asset this derived product documents." ;
    ] .
