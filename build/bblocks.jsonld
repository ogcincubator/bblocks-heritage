    {
      "itemIdentifier": "ogc.heritage.historical-statement",
      "name": "Historical Statement",
      "abstract": "A piece of historical knowledge extracted from a document or legacy record \u2014 an attribution, identification, date assignment or annotation \u2014 modelled as a CIDOC-CRM E13 Attribute Assignment with an inner E33 Linguistic Object and a W3C Web Annotation evidence locator pointing to the source passage.",
      "status": "under-development",
      "dateTimeAddition": "2026-07-16T00:00:00Z",
      "itemClass": "schema",
