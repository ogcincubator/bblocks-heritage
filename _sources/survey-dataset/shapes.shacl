@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix crmdig:  <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .

# properties.choType: "SurveyDataset" maps via context to crmdig:D1_Digital_Object (a second
# alias to @type, alongside the fixed GeoJSON `type: "Feature"`), enabling sh:targetClass here.
# Shape only checks properties introduced by this profile; parent-block constraints are
# inherited via isProfileOf. Coverage (geometry vs. topology) is already enforced structurally
# by the JSON Schema anyOf, not restated here.
<#SurveyDatasetShape>
    a sh:NodeShape ;
    sh:targetClass crmdig:D1_Digital_Object ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:message "title (dct:title) is required." ;
    ] ;
    sh:property [
        sh:path crmdig:L11i_was_output_of ;
        sh:minCount 1 ;
        sh:message "acquisitionEvent (crmdig:L11i_was_output_of, i.e. the D7 acquisition event) is required." ;
    ] ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "isAbout (crm:P129_is_about) is required — URI of the surveyed heritage asset." ;
    ] .
