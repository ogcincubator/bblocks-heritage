          "link": "https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E13"
        },
        {
          "title": "CIDOC-CRM E33 Linguistic Object",
          "link": "https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E33"
        },
        {
          "title": "W3C Web Annotation Data Model",
          "link": "https://www.w3.org/TR/annotation-model/"
        },
        {
          "title": "PROV-O: The PROV Ontology",
          "link": "https://www.w3.org/TR/prov-o/"
        },
        {
          "title": "HERITALISE D8.2 CRRS-014 (Extracted Historical Statement)",
          "link": "https://heritalise-eccch.eu/"
        }
      ],
      "tags": [
