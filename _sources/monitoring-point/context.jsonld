{
  "@context": {
    "crm": "http://www.cidoc-crm.org/cidoc-crm/",
    "crmdig": "http://www.cidoc-crm.org/extensions/crmdig/",
    "sosa": "http://www.w3.org/ns/sosa/",
    "geojson": "https://purl.org/geojson/vocab#",
    "type": "@type",
    "MonitoringPoint": "crmdig:D8_Digital_Device",
    "identifier": "crm:P1_is_identified_by",
    "sensorType": {
      "@id": "crm:P2_has_type",
      "@type": "@id"
    },
    "locatedIn": {
      "@id": "crm:P53_has_former_or_current_location",
      "@type": "@id"
    },
    "operationalStatus": "crm:P44_has_condition",
    "responsibleOrganisation": "crm:P50_has_current_keeper",
    "position": {
      "@id": "geojson:geometry",
      "@type": "@json"
    }
  }
}
