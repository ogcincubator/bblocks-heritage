@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

# type: "OralHistory" maps via context to crm:E73_Information_Object.
# No other block in this register uses that class as a type const, so targetClass is unambiguous.
# (digital-representation has rdfType E73 in bblock.json metadata but no type const in schema,
# so its instances do not carry an explicit crm:E73_Information_Object triple in the uplifted graph.)
<#OralHistoryShape>
    a sh:NodeShape ;
    sh:targetClass crm:E73_Information_Object ;
    sh:property [
        sh:path schema:interviewee ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "interviewee (schema:interviewee) must be present and an IRI referencing an actor." ;
    ] ;
    sh:property [
        sh:path crm:P72_has_language ;
        sh:minCount 1 ;
        sh:message "language (crm:P72_has_language) is required." ;
    ] ;
    sh:property [
        sh:path dct:accessRights ;
        sh:minCount 1 ;
        sh:message "consentStatus (dct:accessRights) is required." ;
    ] ;
    sh:property [
        sh:path crm:P70i_is_documented_in ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "iiifManifest (crm:P70i_is_documented_in) is required." ;
    ] ;
    sh:property [
        sh:path dct:format ;
        sh:minCount 1 ;
        sh:message "mediaType (dct:format) is required." ;
    ] ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "isAbout (crm:P129_is_about) is required — URI of the heritage entity the recording addresses." ;
    ] .
