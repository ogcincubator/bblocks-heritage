@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .

# Architectural space instances uplift to crm:E22_Man-Made_Object via the inherited
# HeritageObject type mapping. These shapes add constraints for space-specific properties.
<#ArchitecturalSpaceShape>
    a sh:NodeShape ;
    sh:targetClass crm:E22_Man-Made_Object ;
    sh:property [
        sh:path crm:P46i_forms_part_of ;
        sh:nodeKind sh:IRI ;
        sh:message "parentBuilding and partOf must uplift to IRIs" ;
    ] ;
    sh:property [
        sh:path crm:P44_has_condition ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "accessibilityStatus must be a string or IRI" ;
    ] .
