@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix hdto:   <http://isl.ics.forth.gr/ontology/echoes/> .

# As with `place`, `actor` and `event`, the uplifted rdf:type comes from PROV-O (prov:Entity)
# rather than crm:E73_Information_Object, so this shape targets by predicate.
<#DigitalRepresentationIsAboutIsIRI>
    a sh:NodeShape ;
    sh:targetSubjectsOf crm:P129_is_about ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "isAbout must uplift to an IRI (was it a relative or malformed URI?)" ;
    ] .

# HDTO co-typing validation. crmdigType/hdtoType (required in schema.yaml) map via context.jsonld
# directly to rdf:type, so every instance is asserted crmdig:D9_Data_Object and its HDTO class on
# a plain JSON-LD parse, no post-processing step needed. This shape only fires for nodes whose
# hdtoType is exactly hdto:HC5_Digital_Representation (plain digital-representation,
# archival-document) — sh:targetClass is exact-match, not rdfs:subClassOf-aware, so HC7/HC8 nodes
# (oral-history/three-d-model, which set hdtoType to the more specific class instead) need their
# own companion shape; see those blocks' shapes.shacl.
<#D9DataObjectShape>
    a sh:NodeShape ;
    sh:targetClass crmdig:D9_Data_Object ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "crmdig:D9_Data_Object instances must carry crm:P129_is_about" ;
    ] .
<#HC5DigitalRepresentationShape>
    a sh:NodeShape ;
    sh:targetClass hdto:HC5_Digital_Representation ;
    sh:property [
        sh:path crm:P129_is_about ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "hdto:HC5_Digital_Representation instances must carry crm:P129_is_about (what the asset represents)" ;
    ] .
