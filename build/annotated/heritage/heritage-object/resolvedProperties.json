{"defs":{},"properties":[{"path":["id"],"id":"@id","description":"The persistent or local URI identifying this object.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"@id"},{"path":["type"],"id":"@type","required":true,"const":"HeritageObject","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"@type"},{"path":["identifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"A local catalogue or inventory number (CIDOC-CRM P1_is_identified_by).","required":true,"schema_type":"string","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["title"],"id":"http://www.cidoc-crm.org/cidoc-crm/P102_has_title","description":"A human-readable title or name for the object (CIDOC-CRM P102_has_title).","required":true,"schema_type":"string","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P102_has_title"},{"path":["description"],"id":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note","description":"Free-text description or curatorial note (CIDOC-CRM P3_has_note).","schema_type":"string","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note"},{"path":["objectType"],"id":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type","jsonld_type":"@id","description":"The type of object, typically a Getty AAT concept URI (CIDOC-CRM P2_has_type).","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type"},{"path":["material"],"id":"http://www.cidoc-crm.org/cidoc-crm/P45_consists_of","jsonld_type":"@id","description":"Materials the object consists of, typically Getty AAT concept URIs (CIDOC-CRM P45_consists_of).","schema_type":"array","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P45_consists_of"},{"path":["currentLocation"],"id":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location","jsonld_type":"@id","description":"URI of the place where the object is currently or was last located (CIDOC-CRM P53_has_former_or_current_location).","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location"},{"path":["persistentIdentifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","jsonld_type":"@id","description":"A persistent identifier (e.g. ARK, DOI, Handle) minted for this object.","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["hdtoType"],"id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type","jsonld_type":"@id","description":"Fixed HDTO co-type (ECCCH Heritage Digital Twin Ontology, D7.1). Maps via context directly to rdf:type, alongside crm:E22_Man-Made_Object \u2014 additive, not a replacement (D7.1 Figure 20's own worked example shows the same node typed as both classes at once). Required so every valid instance is HDTO-typed on a plain JSON-LD parse, with no extra post-processing step needed.","required":true,"schema_type":"string","const":"hdto:HC3_Tangible_Heritage_Entity","sources":["bblocks://ogc.heritage.heritage-object"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type"}]}