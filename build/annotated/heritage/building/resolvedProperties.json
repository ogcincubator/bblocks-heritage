{"defs":{},"properties":[{"path":["id"],"id":"@id","description":"The persistent or local URI identifying this object.","required":true,"schema_type":"string","format":"uri","effectiveId":"@id"},{"path":["type"],"id":"@type","required":true,"const":"HeritageObject","sources":["bblocks://ogc.ogc-utils.topology"],"effectiveId":"@type"},{"path":["identifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"A local catalogue or inventory number (CIDOC-CRM P1_is_identified_by).","required":true,"schema_type":"string","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["title"],"id":"http://www.cidoc-crm.org/cidoc-crm/P102_has_title","description":"A human-readable title or name for the object (CIDOC-CRM P102_has_title).","required":true,"schema_type":"string","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P102_has_title"},{"path":["description"],"id":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note","description":"Free-text description or curatorial note (CIDOC-CRM P3_has_note).","schema_type":"string","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note"},{"path":["objectType"],"id":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type","jsonld_type":"@id","description":"The type of object, typically a Getty AAT concept URI (CIDOC-CRM P2_has_type).","schema_type":"string","format":"uri","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type"},{"path":["material"],"id":"http://www.cidoc-crm.org/cidoc-crm/P45_consists_of","jsonld_type":"@id","description":"Materials the object consists of, typically Getty AAT concept URIs (CIDOC-CRM P45_consists_of).","schema_type":"array","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P45_consists_of"},{"path":["currentLocation"],"id":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location","jsonld_type":"@id","description":"URI of the place where the object is currently or was last located (CIDOC-CRM P53_has_former_or_current_location).","schema_type":"string","format":"uri","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location"},{"path":["persistentIdentifier"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","jsonld_type":"@id","description":"A persistent identifier (e.g. ARK, DOI, Handle) minted for this object.","schema_type":"string","format":"uri","effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["parentSite"],"id":"http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of","jsonld_type":"@id","description":"URI of the heritage-site this building belongs to (crm:P46i_forms_part_of).","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.building"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of"},{"path":["constructionPeriod"],"id":"http://purl.org/dc/terms/created","description":"Date or date range of original construction, ISO 8601 or free text (e.g. \"1675-1690\"). Maps to dct:created.","schema_type":"string","sources":["bblocks://ogc.heritage.building"],"effectiveId":"http://purl.org/dc/terms/created"},{"path":["currentStatus"],"id":"http://www.cidoc-crm.org/cidoc-crm/P44_has_condition","description":"Operational or conservation status (e.g. \"in use\", \"under restoration\", \"closed\"). Maps to crm:P44_has_condition.","schema_type":"string","sources":["bblocks://ogc.heritage.building"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P44_has_condition"},{"path":["responsibleOrganisation"],"id":"http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper","description":"Name or URI of the body responsible for managing this building (crm:P50_has_current_keeper).","schema_type":"string","sources":["bblocks://ogc.heritage.building"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper"},{"path":["ifcGlobalId"],"id":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by","description":"IFC Global ID (GUID) of the corresponding IfcBuilding element in an HBIM model, when available (crm:P1_is_identified_by).","schema_type":"string","sources":["bblocks://ogc.heritage.building"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"},{"path":["footprint"],"id":"https://purl.org/geojson/vocab#geometry","jsonld_type":"@json","description":"Optional GeoJSON geometry representing the building's ground-level footprint or spatial extent.","schema_type":"object","sources":["bblocks://ogc.heritage.building"],"effectiveId":"https://purl.org/geojson/vocab#geometry"},{"path":["footprint","type"],"required":true,"schema_type":"string","enum":["Point","Polygon","MultiPolygon"],"sources":["bblocks://ogc.heritage.building"]},{"path":["footprint","coordinates"],"required":true,"schema_type":"array","sources":["bblocks://ogc.heritage.building"]},{"path":["references"],"id":"https://purl.org/geojson/vocab#relatedFeatures","jsonld_type":"@id","required":true,"schema_type":"array","sources":["bblocks://ogc.ogc-utils.topology"],"effectiveId":"https://purl.org/geojson/vocab#relatedFeatures"}]}