@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix hdto: <http://isl.ics.forth.gr/ontology/echoes/> .

# Heritage-site instances are JSON-FG Features; `type` is fixed to "Feature" so there is no
# crm:E27_Site class triple after uplift (same gotcha as ogc.heritage.place).
# Target on crm:P2_has_type, which siteType (required) always produces.
<#HeritageSiteShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf crm:P2_has_type ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "siteType must be present and must resolve to an IRI" ;
    ] ;
    sh:property [
        sh:path crm:P50_has_current_keeper ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "responsibleOrganisation must be a string or IRI" ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "rights must be a string or IRI" ;
    ] .

# HDTO co-typing validation. hdtoType (required in schema.yaml) maps via context.jsonld directly
# to rdf:type, asserted on a plain JSON-LD parse with no post-processing step.
<#HC3TangibleHeritageEntityShape>
    a sh:NodeShape ;
    sh:targetClass hdto:HC3_Tangible_Heritage_Entity ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:minCount 1 ;
        sh:message "hdto:HC3_Tangible_Heritage_Entity instances must carry a type assertion (crm:P2_has_type)" ;
    ] .
