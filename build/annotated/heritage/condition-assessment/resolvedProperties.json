{"defs":{},"properties":[{"path":["id"],"id":"@id","description":"Persistent URI identifying this condition assessment record.","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"@id"},{"path":["type"],"id":"@type","required":true,"const":"ConditionAssessment","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"@type"},{"path":["affectedObject"],"id":"http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to","jsonld_type":"@id","description":"URI of the heritage-object, architectural-space or place being assessed.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to"},{"path":["conditionState"],"id":"http://www.cidoc-crm.org/cidoc-crm/P35_has_identified","jsonld_type":"@json","description":"The E3 Condition State found by this assessment: the type of condition, its severity and a textual description of its spatial extent.","required":true,"schema_type":"object","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P35_has_identified"},{"path":["conditionState","conditionType"],"description":"Getty AAT URI for the type of condition (e.g. crack, moisture, corrosion).","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.condition-assessment"]},{"path":["conditionState","severity"],"description":"Qualitative severity level.","required":true,"schema_type":"string","enum":["minor","moderate","severe","critical"],"sources":["bblocks://ogc.heritage.condition-assessment"]},{"path":["conditionState","extent"],"description":"Textual description of the area, length or volume affected.","schema_type":"string","sources":["bblocks://ogc.heritage.condition-assessment"]},{"path":["assessmentDate"],"id":"http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date on which the assessment was carried out (ISO 8601).","required":true,"schema_type":"string","format":"date","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"},{"path":["assessor"],"id":"http://www.w3.org/ns/prov#wasAttributedTo","jsonld_type":"@id","description":"URI of the agent (person or organisation) who carried out the assessment.","schema_type":"string","format":"uri","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.w3.org/ns/prov#wasAttributedTo"},{"path":["method"],"id":"http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique","description":"Label or URI of the inspection technique used (e.g. \"visual inspection\", \"thermographic survey\", \"photogrammetric analysis\").","schema_type":"string","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique"},{"path":["confidence"],"description":"Confidence level in the assessment result.","schema_type":"string","enum":["low","medium","high"],"sources":["bblocks://ogc.heritage.condition-assessment"]},{"path":["evidence"],"id":"http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object","jsonld_type":"@id","description":"URIs of digital representations or archival documents used as evidence.","schema_type":"array","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object"},{"path":["recommendation"],"id":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note","description":"Free-text conservation recommendation arising from this assessment.","schema_type":"string","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"http://www.cidoc-crm.org/cidoc-crm/P3_has_note"},{"path":["reviewStatus"],"description":"Workflow status of this record (e.g. draft, reviewed, approved).","schema_type":"string","sources":["bblocks://ogc.heritage.condition-assessment"]},{"path":["footprint"],"id":"https://purl.org/geojson/vocab#geometry","jsonld_type":"@json","description":"GeoJSON geometry localising the condition on the affected object or surface (point, polyline or polygon patch).","schema_type":"object","sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"https://purl.org/geojson/vocab#geometry"},{"path":["footprint","type"],"id":"@type","required":true,"schema_type":"string","enum":["Point","LineString","Polygon","MultiPoint","MultiLineString","MultiPolygon"],"sources":["bblocks://ogc.heritage.condition-assessment"],"effectiveId":"@type"},{"path":["footprint","coordinates"],"required":true,"schema_type":"array","sources":["bblocks://ogc.heritage.condition-assessment"]}]}